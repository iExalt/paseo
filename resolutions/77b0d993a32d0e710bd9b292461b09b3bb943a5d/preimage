interface PendingBrowserToolsRequest {
  host: RegisteredBrowserHost;
  rememberAffinity: boolean;
  timeout: ReturnType<typeof setTimeout>;
  resolve: (payload: BrowserToolsResponsePayload) => void;
  reject: (error: Error) => void;
