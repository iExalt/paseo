  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@xterm/headless": "^6.0.0",
    "dotenv": "^18.0.6",
    "eas-cli": "^24.11.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "expo-gradle-jvmargs": "^1.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "material-icon-theme": "^5.32.0",
    "playwright": "^1.63.0",
    "serve-sim": "^0.1.40",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "ws": "^8.22.0"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
