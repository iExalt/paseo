{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "strict": true,
    // Keep legacy React Native types until app code and dependencies migrate to Strict API.
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["../../plugin-examples/**/*.ts", "../../plugin-examples/**/*.tsx"]
}
