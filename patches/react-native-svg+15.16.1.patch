+  private boolean canDrawDirectly() {
+    if (getWidth() < 1 || getHeight() < 1) {
+      return false;
+    }
+    for (int i = 0; i < getChildCount(); i++) {
+      if (!isDirectlyDrawable(getChildAt(i))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean isDirectlyDrawable(View view) {
+    Class<?> type = view.getClass();
+    boolean isShape =
+        type == PathView.class
+            || type == CircleView.class
+            || type == EllipseView.class
+            || type == LineView.class
+            || type == RectView.class;
+    if (!isShape && type != GroupView.class) {
+      return false;
+    }
+    RenderableView node = (RenderableView) view;
+    if (node.mMask != null
+        || node.hasClipPath()
+        || node.mFilter != null
+        || node.mMarkerStart != null
+        || node.mMarkerMid != null
+        || node.mMarkerEnd != null) {
+      return false;
+    }
+    if (type != GroupView.class) {
+      return true;
+    }
+    if (node.mOpacity != 1) {
+      return false;
+    }
+    GroupView group = (GroupView) view;
+    for (int i = 0; i < group.getChildCount(); i++) {
+      if (!isDirectlyDrawable(group.getChildAt(i))) {
+        return false;
+      }
+    }
+    return true;
+  }
